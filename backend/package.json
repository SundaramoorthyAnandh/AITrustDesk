{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TrustDesk API — Fastify + Drizzle(SQLite) + LangChain + minisearch.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "load": "npm run db:migrate && tsx src/loaders/load.ts",
    "eval": "npm run db:migrate && tsx src/eval/runner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@langchain/core": "^0.3.18",
    "@langchain/openai": "^0.3.14",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "minisearch": "^7.1.0",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
