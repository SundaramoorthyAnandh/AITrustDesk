# ─────────────────────────────────────────────────────────────
# TrustDesk API — environment configuration
# Copy to `.env` and adjust. All values below are safe demo defaults.
# ─────────────────────────────────────────────────────────────

# HTTP
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed CORS origins (the two portals).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SQLite database file (relative to backend/ or absolute).
DATABASE_URL=./trustdesk.db

# Reseed on every boot. Leave false locally (use `npm run load`). Set true on
# ephemeral hosts (e.g. Render free tier) so a fresh disk is always seeded.
SEED_ON_BOOT=false

# ─── Auth (separate customer/agent JWT pipelines) ───
# Use long random strings in any real deployment. Distinct secrets keep the
# two audiences cryptographically isolated: a customer token can never be
# replayed against an agent-only route and vice versa.
CUSTOMER_JWT_SECRET=dev-customer-secret-change-me
AGENT_JWT_SECRET=dev-agent-secret-change-me
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=1209600     # seconds (14 days)

# Default password applied to every seeded account by `npm run load`.
# (Documented in README; change before any non-demo use.)
SEED_DEFAULT_PASSWORD=Password123!

# ─── LLM provider ───
# LLM_PROVIDER: "mock" (deterministic fixtures, default) or "langchain" (LM Studio).
LLM_PROVIDER=mock
# LM Studio / any OpenAI-compatible endpoint:
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
MODEL_NAME=local-model
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=30000
